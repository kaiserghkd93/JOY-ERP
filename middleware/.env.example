# PDF 에이전트 설정 파일
# 이 파일을 복사해서 .env 로 저장 후 값을 채우세요

# Railway ERP URL (끝 슬래시 없이)
ERP_BASE_URL=https://your-app.railway.app

# 명세서 PDF 저장 경로
INVOICE_DIR=\\192.168.0.124\e\명세서,발주서 저장폴더\명세서 집계

# 발주서 PDF 저장 경로 (업체별 하위폴더 자동 생성됨)
PO_DIR=\\192.168.0.124\e\명세서,발주서 저장폴더\발주서 집계

# 에이전트 포트 (기본 9091)
AGENT_PORT=9091
